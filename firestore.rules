rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Individual products collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Products catalog: readable and writable by everyone
    match /catalog/{document=**} {
      allow read, write: if true;
    }
    
    // Wholesale inquiries: public submission
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Customer orders
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
